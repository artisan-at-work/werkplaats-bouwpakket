{
    "permissions": {
        "allow": [
            "Bash(bin/meting:*)",
            "Bash(php artisan test:*)",
            "Bash(vendor/bin/pest:*)",
            "Bash(vendor/bin/phpunit:*)",
            "Bash(vendor/bin/phpstan:*)",
            "Bash(npm test:*)",
            "Bash(git diff:*)",
            "Bash(git status:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(git ls-files:*)",
            "Bash(cat:*)",
            "Bash(ls:*)",
            "Bash(grep:*)",
            "Bash(head:*)",
            "Bash(tail:*)",
            "Bash(wc:*)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(./evals/**)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/grens.sh\""
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/klaar.sh\"",
                        "timeout": 600
                    }
                ]
            }
        ]
    }
}

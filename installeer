#!/usr/bin/env bash
# Zet het bouwpakket in de repo waar je nu staat. Overschrijft niets.
#
# Zonder iets te downloaden, in de map van je applicatie:
#   curl -fsSL https://raw.githubusercontent.com/artisan-at-work/werkplaats-bouwpakket/main/installeer | bash
#
# Met het bouwpakket naast je repo:
#   ../werkplaats-bouwpakket/installeer

BRON="artisan-at-work/werkplaats-bouwpakket"
TAK="${WERKPLAATS_TAK:-main}"

if [ ! -f composer.json ] && [ ! -f package.json ]; then
  echo "Hier staat geen composer.json of package.json. Ga naar de map van je applicatie en probeer het opnieuw."
  exit 1
fi

HIER="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd)"

if [ -n "$HIER" ] && [ -f "$HIER/installeer" ] && [ -f "$HIER/pakket/.claude/commands/inrichten.md" ]; then
  # Het bouwpakket staat lokaal.
  PAKKET="$HIER/pakket"
  if [ "$(pwd)" = "$HIER" ]; then
    echo "Je staat in het bouwpakket zelf. Ga naar je eigen repo, bijvoorbeeld: cd ../werkplaats-oefenrepo"
    exit 1
  fi
else
  # Opgehaald met curl: download het pakket naar .werkplaats/ in deze repo.
  # /inrichten leest daar de sjablonen. Git negeert de map.
  echo "Bouwpakket ophalen..."
  DOEL="$(pwd)/.werkplaats/bouwpakket"
  rm -rf "$DOEL" && mkdir -p "$DOEL"
  if ! (set -o pipefail; curl -fsSL "https://codeload.github.com/$BRON/tar.gz/$TAK" | tar xz -C "$DOEL" --strip-components=1) 2>/dev/null; then
    if command -v gh >/dev/null && (set -o pipefail; gh api "repos/$BRON/tarball/$TAK" | tar xz -C "$DOEL" --strip-components=1) 2>/dev/null; then
      :
    else
      echo "Het bouwpakket kon niet worden opgehaald. Is de repo bereikbaar, of ben je ingelogd met gh auth login?"
      exit 1
    fi
  fi
  PAKKET="$DOEL/pakket"
  if [ -d .git ] && ! grep -qx '.werkplaats/' .git/info/exclude 2>/dev/null; then
    echo '.werkplaats/' >> .git/info/exclude
  fi
fi

nieuw=()
bestond=()

while IFS= read -r rel; do
  if [ -e "$rel" ]; then
    bestond+=("$rel")
  else
    mkdir -p "$(dirname "$rel")"
    cp "$PAKKET/$rel" "$rel"
    nieuw+=("$rel")
  fi
done < <(cd "$PAKKET" && find . -type f ! -name ".DS_Store" | sed 's|^\./||' | sort)

# /inrichten moet weten waar de sjablonen staan.
if [ -f .claude/commands/inrichten.md ]; then
  sed "s|{{PAKKET}}|$PAKKET|g" .claude/commands/inrichten.md > .claude/commands/inrichten.md.tmp && mv .claude/commands/inrichten.md.tmp .claude/commands/inrichten.md
fi
chmod +x bin/meting .claude/hooks/*.sh 2>/dev/null

# Het stappenplan krijgt de naam van deze repo.
PLAN="docs/agents/stappenplan.html"
if [ -f "$PLAN" ]; then
  REPO="$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")"
  sed "s|{{REPO}}|$REPO|g" "$PLAN" > "$PLAN.tmp" && mv "$PLAN.tmp" "$PLAN"
fi

echo "Neergezet:"
for f in "${nieuw[@]}"; do echo "  + $f"; done

if [ "${#bestond[@]}" -gt 0 ]; then
  echo
  echo "Bestond al, blijft staan. /inrichten voegt het sjabloon samen met jullie versie:"
  for f in "${bestond[@]}"; do echo "  = $f"; done
fi

echo
echo "Stappenplan: $PLAN"
echo "Volgende stap: start claude en typ /inrichten"

# Open het stappenplan in de browser. Zet WERKPLAATS_NIET_OPENEN=1 om dat over te slaan.
if [ -f "$PLAN" ] && [ -z "${WERKPLAATS_NIET_OPENEN:-}" ]; then
  case "$(uname -s)" in
    Darwin) open "$PLAN" ;;
    Linux) command -v xdg-open >/dev/null && xdg-open "$PLAN" >/dev/null 2>&1 & ;;
    MINGW*|MSYS*|CYGWIN*) start "" "$PLAN" ;;
  esac
fi
